    {
      "parameters": {
        "jsCode": "// CÓDIGO OTIMIZADOR ATUALIZADO (Com as novas colunas inclusas)\nconst scoreMinimo = 4; \nconst resultadosFiltrados = [];\n\nfor (const item of $input.all()) {\n  const opport = item.json;\n  if (!opport || opport.error || Object.keys(opport).length === 0) continue;\n  \n  const listaOportunidades = Array.isArray(opport) ? opport : [opport];\n\n  for (const op of listaOportunidades) {\n    const scoreItem = parseFloat(op.score) || 0;\n\n    // Filtra única e exclusivamente pelo Score mínimo\n    if (scoreItem > scoreMinimo) {\n      resultadosFiltrados.push({ \n        json: {\n          Titulo: op.OPPORT_DESCR || \"Sem Título\",\n          Numero_Licitacao: op.OPPORT_NUM || (op.ITEMS && op.ITEMS[0] ? (op.ITEMS[0].FAMILY || op.ITEMS[0].NUM_MATERIAL || op.ITEMS[0].DESC_OBJ_CONTRAT || op.ITEMS[0].OPEN_DATE) : \"Sem Número\"),\n          Descricao: (op.ITEMS && op.ITEMS[0] && op.ITEMS[0].ITEM_DESC) || \"Sem Descrição\",\n          \n          // --- NOVAS COLUNAS ADICIONADAS AQUI ---\n          Objeto_Contratacao: (op.ITEMS && op.ITEMS[0] && op.ITEMS[0].DESC_OBJ_CONTRAT) || \"Não informado\",\n          Data_Abertura: (op.ITEMS && op.ITEMS[0] && op.ITEMS[0].OPEN_DATE) || \"Não informada\",\n          \n          Data_Encerramento: op.END_DATE || \"Não informada\",\n          Score: scoreItem\n        } \n      });\n    }\n  }\n}\n\n// --- SE ESTIVER VAZIO, ENVIA O SINAL QUE EVITA TRAVAR O LOOP ---\nif (resultadosFiltrados.length === 0) {\n  return [{ json: { semResultados: true } }];\n}\n\nreturn resultadosFiltrados;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1856,
        1552
      ],
      "id": "49591486-6e6a-45a6-8ef2-5e22f976de94",
      "name": "Otimizador"
    },
    {
      "parameters": {
        "jsCode": "// CÓDIGO AGREGADOR ULTRA SIMPLIFICADO\n// Ele apenas limpa os dados que o Loop já entregou na entrada dele\n\nconst resultadosLimpos = [];\nconst vistos = new Set();\n\n// Varre as 27 linhas que já chegaram prontas no nó\nfor (const item of $input.all()) {\n  \n  // Só aceita itens que tenham um Número de Licitação (ignora os undefined e semResultados)\n  if (item.json && item.json.Numero_Licitacao && !item.json.semResultados) {\n    const idLicitacao = item.json.Numero_Licitacao;\n    \n    // Remove duplicados para não repetir linhas na planilha\n    if (!vistos.has(idLicitacao)) {\n      vistos.add(idLicitacao);\n      resultadosLimpos.push(item);\n    }\n  }\n}\n\nreturn resultadosLimpos;"
      },
