    {
      "parameters": {
        "jsCode": "const keywords = [\n  'Construção e Montagem',\n  'Instalação de City Gates',\n  'Instalação de Conjuntos de Regulagem',\n  'Instalação de Conjuntos de Regulagem e Medição',\n  'Tubulação',\n  'Serviços de Construção',\n  'Montagem',\n  'Manutenção',\n  'Válvulas Reguladoras',\n  'Válvulas Shutoff',\n  'Válvulas de Segurança',\n  'Corretores de vazão',\n  'Transmissores de pressão',\n  'Transdutores de pressão',\n  'medidores de vazão',\n  'Conjuntos de Regulagem e Medição',\n  'Conjuntos de Regulagem',\n  'Skid de Regulagem e Medição',\n  'City Gates',\n  'Aquecedor de Gás Natural',\n  'Sistemas Filtragem de Gás Natural',\n  'Cromatógrafos'\n];\n\nfunction normalizeText(value) {\n  return String(value || '')\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .toLowerCase()\n    .trim();\n}\n\nconst normalizedKeywords = keywords.map(normalizeText);\n\nconst result = $input.all()\n  .filter(item => {\n    const j = item.json || {};\n    const etapa = normalizeText(j['Etapa']);\n    const tipo = normalizeText(j['Tipo']);\n    const natureza = normalizeText(j['Natureza']);\n    const objeto = normalizeText(j['Objeto']);\n    const dataRaw = String(j['Data de abertura'] || '').trim();\n\n    const parts = dataRaw.split('/');\n    const data = parts.length === 3\n      ? new Date(`${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}T00:00:00`)\n      : null;\n\n    const limite = new Date('2020-01-01T00:00:00');\n\n    return etapa.includes('recebimento de propostas') &&\n      tipo.includes('cotação') &&\n      natureza.includes('serviços') &&\n      data &&\n      data >= limite &&\n      normalizedKeywords.some(k => objeto.includes(k));\n  })\n  .map(item => ({ json: item.json }));\n\nreturn result.length ? result : [{ json: {} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1376,
        656
      ],
