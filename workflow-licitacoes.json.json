    {
      "parameters": {
        "jsCode": "const inputItem = $input.first();\nconst tokenRecebido = inputItem.json.token;\n\nconst keywords = [\n  'construcao',\n  'montagem', \n  'manutencao',\n  'tubulacao', \n  'Tubulação',\n  'gates', \n  'skid', \n  'aquecedor', \n  'filtragem',\n  'regulagem', \n  'medicao', \n  'conjuntos',\n  'vazao', \n  'pressao', \n  'transmissores',\n  'transdutores', \n  'medidores',\n  'cromatografos',\n  'cromatógrafo', \n  'valvulas'\n];\n\nreturn keywords.map(termo => ({ \n  json: { \n    query: termo,\n    token: tokenRecebido\n  },\n  pairedItem: {\n    item: 0\n  }\n}));"
      },
