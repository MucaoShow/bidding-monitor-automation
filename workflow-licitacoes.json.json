    {
      "parameters": {
        "jsCode": "const keywords = [\n  'válvula',\n  'válvulas',\n  'medição de vazão',\n  'estação de redução',\n  'estações de redução',\n  'conjunto de regulagem',\n  'conjuntos de regulagem',\n  'city gate',\n  'city gates',\n  'pead',\n  'bloqueio automático',\n  'transmissor de pressão',\n  'transmissores de pressão',\n  'transdutor de pressão',\n  'transdutores de pressão',\n  'medidor de vazão',\n  'medidores de vazão',\n  'skid',\n  'cromatógrafo',\n  'gás natural',\n  'montagem',\n  'construção'\n];\n\nfunction norm(v) {\n  return String(v ?? '')\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nconst out = [];\n\nfor (const item of $input.all()) {\n  const j = item.json || {};\n\n  const rawStatus = Array.isArray(j.tipoHistorico) ? j.tipoHistorico[0] : j.tipoHistorico;\n  const status = norm(rawStatus);\n  if (!(status.includes('aberta') || status.includes('aberto'))) continue;\n\n  const texto = norm(j.objeto);\n  const matched = keywords.find(k => texto.includes(norm(k)));\n  if (!matched) continue;\n\n  out.push({\n    json: {\n      empresa: 'MSGÁS',\n      link: 'https://msgas.com.br/chamada-publica/',\n      objetivo: String(j.objeto ?? '').trim(),\n      dataAbertura: String(j.dataAbertura ?? '').trim(),\n      dataFechamento: String(j.dataFechamento ?? '').trim(),\n      numero: String(j.numero ?? '').trim(),\n      status: String(rawStatus ?? '').trim(),\n      disciplina: matched,\n      id: String(j.numero ?? '').trim() || `sem-id-${String(j.dataAbertura ?? '').trim()}`\n    }\n  });\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        1008
      ],
      "id": "ab860fd9-3cb4-4efe-a562-ef28ebb8b237",
      "name": "Filter"
    },
    {
      "parameters": {
        "jsCode": "const out = [];\n\nfor (let inputIndex = 0; inputIndex < $input.all().length; inputIndex++) {\n  const item = $input.all()[inputIndex];\n  const j = item.json || {};\n\n  const objetos = Array.isArray(j.objeto) ? j.objeto : [j.objeto];\n  const datas = Array.isArray(j.dataAbertura) ? j.dataAbertura : [j.dataAbertura];\n  const numeros = Array.isArray(j.numero) ? j.numero : [j.numero];\n  const modalidades = Array.isArray(j.modalidade) ? j.modalidade : [j.modalidade];\n  const fechamentos = Array.isArray(j.dataFechamento) ? j.dataFechamento : [j.dataFechamento];\n  const statuses = Array.isArray(j.tipoHistorico) ? j.tipoHistorico : [j.tipoHistorico];\n\n  const maxLen = Math.max(objetos.length, datas.length, numeros.length, modalidades.length, fechamentos.length, statuses.length);\n\n  for (let i = 0; i < maxLen; i++) {\n    out.push({\n      json: {\n        empresa: j.empresa ?? '',\n        linkEmpresa: j.linkEmpresa ?? '',\n        objeto: objetos[i] ?? '',\n        dataAbertura: datas[i] ?? '',\n        numero: numeros[i] ?? '',\n        modalidade: modalidades[i] ?? '',\n        dataFechamento: fechamentos[i] ?? '',\n        tipoHistorico: statuses[i] ?? '',\n      },\n      pairedItem: { item: inputIndex },\n    });\n  }\n}\n\nreturn out;"
      },
